// Velnox Prisma Schema
// Foundation models per docs/12_Database_Design.md
// Note: this Foundation ships User/Role/Profile fully wired, plus relations
// scaffolded for Merchant, Shop, Product, Category, Order and VelRepeat so
// later feature work can extend these models without re-architecting.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------
// Enums
// -----------------------------

enum UserRole {
  CUSTOMER
  MERCHANT
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum MerchantStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ShopStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum VelRepeatFrequency {
  WEEKLY
  BI_WEEKLY
  MONTHLY
  CUSTOM
}

enum VelRepeatStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

// -----------------------------
// User Domain
// -----------------------------

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  name         String
  phone        String?
  role         UserRole   @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  profile             UserProfile?
  addresses            Address[]
  refreshTokens        RefreshToken[]
  merchant             Merchant?
  orders               Order[]
  cart                 Cart?
  velrepeatSubscriptions VelRepeatSubscription[]
  notifications        Notification[]

  @@map("users")
}

model UserProfile {
  id          String    @id @default(uuid())
  userId      String    @unique @map("user_id")
  avatarUrl   String?   @map("avatar_url")
  dateOfBirth DateTime? @map("date_of_birth")
  gender      String?
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Address {
  id          String  @id @default(uuid())
  userId      String  @map("user_id")
  name        String
  phone       String
  addressLine String  @map("address_line")
  city        String
  province    String
  postalCode  String  @map("postal_code")
  country     String  @default("TH")
  isDefault   Boolean @default(false) @map("is_default")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

// Not in the original doc table list, but required to support refresh-token
// rotation/revocation safely (see docs/15_Security_Architecture.md).
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  revoked   Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// -----------------------------
// Merchant Domain
// -----------------------------

model Merchant {
  id         String         @id @default(uuid())
  userId     String         @unique @map("user_id")
  status     MerchantStatus @default(PENDING)
  approvedAt DateTime?      @map("approved_at")
  createdAt  DateTime       @default(now()) @map("created_at")

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  shops      Shop[]
  orderItems OrderItem[]
  reports    MerchantReport[]

  @@map("merchants")
}

model Shop {
  id          String     @id @default(uuid())
  merchantId  String     @map("merchant_id")
  name        String
  description String?
  logoUrl     String?    @map("logo_url")
  bannerUrl   String?    @map("banner_url")
  status      ShopStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @map("created_at")

  merchant Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  products Product[]

  @@map("shops")
}

// -----------------------------
// Product Domain
// -----------------------------

model Category {
  id       String  @id @default(uuid())
  name     String
  slug     String  @unique
  imageUrl String? @map("image_url")
  parentId String? @map("parent_id")
  status   String  @default("ACTIVE")

  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToCategory")
  products Product[]

  @@map("categories")
}

model Product {
  id          String        @id @default(uuid())
  shopId      String        @map("shop_id")
  categoryId  String        @map("category_id")
  name        String
  slug        String        @unique
  description String?
  price       Decimal       @db.Decimal(12, 2)
  stock       Int           @default(0)
  status      ProductStatus @default(DRAFT)
  createdAt   DateTime      @default(now()) @map("created_at")

  shop                   Shop                     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category               Category                 @relation(fields: [categoryId], references: [id])
  images                 ProductImage[]
  inventory              Inventory?
  cartItems              CartItem[]
  orderItems             OrderItem[]
  velrepeatSubscriptions VelRepeatSubscription[]

  @@map("products")
}

model ProductImage {
  id        String @id @default(uuid())
  productId String @map("product_id")
  url       String
  publicId  String @map("public_id")
  sortOrder Int    @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

// -----------------------------
// Inventory Domain
// -----------------------------

model Inventory {
  id                String   @id @default(uuid())
  productId         String   @unique @map("product_id")
  quantity          Int      @default(0)
  reservedQuantity  Int      @default(0) @map("reserved_quantity")
  updatedAt         DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

// -----------------------------
// Cart Domain
// -----------------------------

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String  @map("cart_id")
  productId String  @map("product_id")
  quantity  Int
  price     Decimal @db.Decimal(12, 2)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("cart_items")
}

// -----------------------------
// Order Domain
// -----------------------------

model Order {
  id            String        @id @default(uuid())
  userId        String        @map("user_id")
  orderNumber   String        @unique @map("order_number")
  status        OrderStatus   @default(PENDING)
  subtotal      Decimal       @db.Decimal(12, 2)
  shippingFee   Decimal       @default(0) @db.Decimal(12, 2) @map("shipping_fee")
  total         Decimal       @db.Decimal(12, 2)
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  createdAt     DateTime      @default(now()) @map("created_at")

  user    User        @relation(fields: [userId], references: [id])
  items   OrderItem[]
  payment Payment?

  @@map("orders")
}

// Supports multi-merchant orders: a single order can contain items fulfilled
// by different merchants (see docs/12_Database_Design.md section 10.2).
model OrderItem {
  id         String  @id @default(uuid())
  orderId    String  @map("order_id")
  productId  String  @map("product_id")
  merchantId String  @map("merchant_id")
  quantity   Int
  price      Decimal @db.Decimal(12, 2)

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])
  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@map("order_items")
}

// -----------------------------
// Payment Domain
// -----------------------------

model Payment {
  id            String        @id @default(uuid())
  orderId       String        @unique @map("order_id")
  method        String
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(PENDING)
  transactionId String?       @map("transaction_id")
  paidAt        DateTime?     @map("paid_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// -----------------------------
// VelRepeat Domain (Subscriptions)
// -----------------------------

model VelRepeatSubscription {
  id            String             @id @default(uuid())
  userId        String             @map("user_id")
  productId     String             @map("product_id")
  frequency     VelRepeatFrequency
  quantity      Int
  status        VelRepeatStatus    @default(ACTIVE)
  nextOrderDate DateTime           @map("next_order_date")
  createdAt     DateTime           @default(now()) @map("created_at")

  user    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product                 @relation(fields: [productId], references: [id])
  history VelRepeatHistory[]

  @@map("velrepeat_subscriptions")
}

model VelRepeatHistory {
  id             String   @id @default(uuid())
  subscriptionId String   @map("subscription_id")
  action         String
  createdAt      DateTime @default(now()) @map("created_at")

  subscription VelRepeatSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("velrepeat_history")
}

// -----------------------------
// Notification Domain
// -----------------------------

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  title     String
  message   String
  type      String
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// -----------------------------
// Analytics Domain (VelCenter)
// -----------------------------

model SalesReport {
  id          String   @id @default(uuid())
  date        DateTime
  totalOrders Int      @default(0) @map("total_orders")
  totalSales  Decimal  @default(0) @db.Decimal(14, 2) @map("total_sales")
  totalUsers  Int      @default(0) @map("total_users")

  @@map("sales_reports")
}

model MerchantReport {
  id         String  @id @default(uuid())
  merchantId String  @map("merchant_id")
  sales      Decimal @default(0) @db.Decimal(14, 2)
  orders     Int     @default(0)
  customers  Int     @default(0)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("merchant_reports")
}
