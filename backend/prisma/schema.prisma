// Velnox Prisma Schema
// Foundation models per docs/12_Database_Design.md
// Note: this Foundation ships User/Role/Profile fully wired, plus relations
// scaffolded for Merchant, Shop, Product, Category, Order and VelRepeat so
// later feature work can extend these models without re-architecting.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------
// Enums
// -----------------------------

enum UserRole {
  CUSTOMER
  MERCHANT
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum MerchantStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ShopStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum VelRepeatFrequency {
  WEEKLY
  BI_WEEKLY
  MONTHLY
  CUSTOM
}

enum VelRepeatStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

// -----------------------------
// User Domain
// -----------------------------

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  name         String
  phone        String?
  role         UserRole   @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  profile             UserProfile?
  addresses            Address[]
  refreshTokens        RefreshToken[]
  merchant             Merchant?
  orders               Order[]
  cart                 Cart?
  velrepeatSubscriptions VelRepeatSubscription[]
  notifications        Notification[]

  @@map("users")
}

model UserProfile {
  id          String    @id @default(uuid())
  userId      String    @unique @map("user_id")
  avatarUrl   String?   @map("avatar_url")
  dateOfBirth DateTime? @map("date_of_birth")
  gender      String?
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Address {
  id          String  @id @default(uuid())
  userId      String  @map("user_id")
  name        String
  phone       String
  addressLine String  @map("address_line")
  city        String
  province    String
  postalCode  String  @map("postal_code")
  country     String  @default("TH")
  isDefault   Boolean @default(false) @map("is_default")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

// Not in the original doc table list, but required to support refresh-token
// rotation/revocation safely (see docs/15_Security_Architecture.md).
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  revoked   Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// -----------------------------
// Merchant Domain
// -----------------------------

model Merchant {
  id         String         @id @default(uuid())
  userId     String         @unique @map("user_id")
  status     MerchantStatus @default(PENDING)
  approvedAt DateTime?      @map("approved_at")
  createdAt  DateTime       @default(now()) @map("created_at")

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  shops      Shop[]
  orderItems OrderItem[]
  reports    MerchantReport[]

  @@map("merchants")
}

model Shop {
  id          String     @id @default(uuid())
  merchantId  String     @map("merchant_id")
  name        String
  description String?
  logoUrl     String?    @map("logo_url")
  bannerUrl   String?    @map("banner_url")
  status      ShopStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @map("created_at")

  merchant Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  products Product[]

  @@map("shops")
}

// -----------------------------
// Product Domain
// -----------------------------

model Category {
  id       String  @id @default(uuid())
  name     String
  slug     String  @unique
  imageUrl String? @map("image_url")
  parentId String? @map("parent_id")
  status   String  @default("ACTIVE")

  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToCategory")
  products Product[]

  @@map("categories")
}

model Product {
  id          String        @id @default(uuid())
  shopId      String        @map("shop_id")
  categoryId  String        @map("category_id")
  name        String
  slug        String        @unique
  sku         String        @unique
  sellerSku   String?       @map("seller_sku")
  description String?
  price       Decimal       @db.Decimal(12, 2)
  stock       Int           @default(0)
  status      ProductStatus @default(DRAFT)
  createdAt   DateTime      @default(now()) @map("created_at")

  shop                   Shop                     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category               Category                 @relation(fields: [categoryId], references: [id])
  images                 ProductImage[]
  inventory              Inventory?
  cartItems              CartItem[]
  orderItems             OrderItem[]
  velrepeatSubscriptions VelRepeatSubscription[]

  @@index([sellerSku])
  @@map("products")
}

model ProductImage {
  id        String @id @default(uuid())
  productId String @map("product_id")
  url       String
  publicId  String @map("public_id")
  sortOrder Int    @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

// -----------------------------
// Inventory Domain
// -----------------------------

model Inventory {
  id                String   @id @default(uuid())
  productId         String   @unique @map("product_id")
  quantity          Int      @default(0)
  reservedQuantity  Int      @default(0) @map("reserved_quantity")
  updatedAt         DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

// -----------------------------
// Cart Domain
// -----------------------------

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String  @map("cart_id")
  productId String  @map("product_id")
  quantity  Int
  price     Decimal @db.Decimal(12, 2)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("cart_items")
}

// -----------------------------
// Order Domain
// -----------------------------

model Order {
  id            String        @id @default(uuid())
  userId        String        @map("user_id")
  orderNumber   String        @unique @map("order_number")
  status        OrderStatus   @default(PENDING)
  subtotal      Decimal       @db.Decimal(12, 2)
  shippingFee   Decimal       @default(0) @db.Decimal(12, 2) @map("shipping_fee")
  total         Decimal       @db.Decimal(12, 2)
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  createdAt     DateTime      @default(now()) @map("created_at")

  user    User        @relation(fields: [userId], references: [id])
  items   OrderItem[]
  payment Payment?

  @@map("orders")
}

// Supports multi-merchant orders: a single order can contain items fulfilled
// by different merchants (see docs/12_Database_Design.md section 10.2).
model OrderItem {
  id         String  @id @default(uuid())
  orderId    String  @map("order_id")
  productId  String  @map("product_id")
  merchantId String  @map("merchant_id")
  quantity   Int
  price      Decimal @db.Decimal(12, 2)

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])
  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@map("order_items")
}

// -----------------------------
// Payment Domain
// -----------------------------

model Payment {
  id            String        @id @default(uuid())
  orderId       String        @unique @map("order_id")
  method        String
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(PENDING)
  transactionId String?       @map("transaction_id")
  paidAt        DateTime?     @map("paid_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// -----------------------------
// VelRepeat Domain (Prepaid Pack)
// -----------------------------

enum VelRepeatFrequency {
  WEEKLY
  BI_WEEKLY
  MONTHLY
}

enum VelRepeatPackStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

/// แพ็กที่ลูกค้าซื้อ (จ่ายก้อนเดียว)
model VelRepeatPack {
  id               String              @id @default(uuid())
  userId           String              @map("user_id")
  productId        String              @map("product_id")

  planCode         String              @map("plan_code")   // e.g. WEEKLY_4, MONTHLY_3
  frequency        VelRepeatFrequency
  totalUnits       Int                 @map("total_units") // จำนวนชิ้นทั้งหมดในแพ็ก
  remainingUnits   Int                 @map("remaining_units")
  unitsPerDelivery Int                 @default(1) @map("units_per_delivery")

  unitPrice        Decimal             @db.Decimal(12, 2) @map("unit_price") // ราคาต่อชิ้นในแพ็ก
  packPrice        Decimal             @db.Decimal(12, 2) @map("pack_price") // ยอดที่จ่ายจริง
  freeShipping     Boolean             @default(true) @map("free_shipping")

  status           VelRepeatPackStatus @default(ACTIVE)
  nextDeliveryDate DateTime            @map("next_delivery_date")
  prepaidPaymentId String?             @map("prepaid_payment_id") // อ้างอิง payment ก้อนเดียว

  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  product    Product                @relation(fields: [productId], references: [id])
  deliveries VelRepeatDelivery[]
  history    VelRepeatHistory[]

  @@index([userId, status])
  @@index([nextDeliveryDate, status])
  @@map("velrepeat_packs")
}

/// แต่ละรอบที่ระบบส่งของจากเครดิตแพ็ก
model VelRepeatDelivery {
  id          String    @id @default(uuid())
  packId      String    @map("pack_id")
  orderId     String?   @unique @map("order_id") // order ที่สร้างเพื่อส่งของ (paymentStatus = PAID)
  units       Int       @default(1)
  scheduledAt DateTime  @map("scheduled_at")
  deliveredAt DateTime? @map("delivered_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  pack  VelRepeatPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  order Order?        @relation(fields: [orderId], references: [id])

  @@map("velrepeat_deliveries")
}

model VelRepeatHistory {
  id        String   @id @default(uuid())
  packId    String   @map("pack_id")
  action    String   // PURCHASED | DELIVERED | PAUSED | RESUMED | CANCELLED | COMPLETED | SKIPPED_OUT_OF_STOCK
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  pack VelRepeatPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@map("velrepeat_history")
}

// -----------------------------
// Notification Domain
// -----------------------------

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  title     String
  message   String
  type      String
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// -----------------------------
// Analytics Domain (VelCenter)
// -----------------------------

model SalesReport {
  id          String   @id @default(uuid())
  date        DateTime
  totalOrders Int      @default(0) @map("total_orders")
  totalSales  Decimal  @default(0) @db.Decimal(14, 2) @map("total_sales")
  totalUsers  Int      @default(0) @map("total_users")

  @@map("sales_reports")
}

model MerchantReport {
  id         String  @id @default(uuid())
  merchantId String  @map("merchant_id")
  sales      Decimal @default(0) @db.Decimal(14, 2)
  orders     Int     @default(0)
  customers  Int     @default(0)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("merchant_reports")
}

// -----------------------------
// Platform Settings (VelCenter)
// -----------------------------

model PlatformSettings {
  id                   String   @id @default("default")
  platformName         String   @default("Velnox Commerce Platform") @map("platform_name")
  commissionPercent    Decimal  @default(5) @db.Decimal(5, 2) @map("commission_percent")
  autoApproveMerchants Boolean  @default(false) @map("auto_approve_merchants")
  requireProductReview Boolean  @default(true) @map("require_product_review")
  paymentCreditCard    Boolean  @default(true) @map("payment_credit_card")
  paymentPromptPay     Boolean  @default(true) @map("payment_prompt_pay")
  paymentBankTransfer  Boolean  @default(true) @map("payment_bank_transfer")
  paymentCod           Boolean  @default(true) @map("payment_cod")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  autoApproveProducts  Boolean  @default(false) @map("auto_approve_products")

  @@map("platform_settings")
}