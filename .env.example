# ==========================================
# Velnox - Environment Variables Example
# Copy this file to .env and fill in values
# ==========================================

# Database (Neon PostgreSQL compatible)
DATABASE_URL="postgresql://user:password@host:5432/velnox?schema=public"

# JWT Authentication
JWT_SECRET="change-me-access-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Cloudinary (Media Storage)
CLOUDINARY_NAME=""
CLOUDINARY_KEY=""
CLOUDINARY_SECRET=""

# Backend
PORT=4000
NODE_ENV="development"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002"

# Frontend (public, exposed to browser)
NEXT_PUBLIC_API_URL="http://localhost:4000"
